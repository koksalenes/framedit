@{
    ViewData["Title"] = "Tools";
}

<section class="hero">
    <div class="hero-inner">
        <span class="hero-label">Local · Private · Fast</span>
        <h1 class="hero-title">Media tools that<br><span>just work.</span></h1>
        <p class="hero-sub">A focused suite for parsing, cleaning, and optimizing your media. Running entirely in Docker on your own machine.</p>
    </div>
</section>

<section class="tools-grid-section">
    <div class="container">
        <div class="tools-grid">

            <a class="tool-card" asp-controller="VideoFrameParser" asp-action="Index">
                <div class="tool-card-icon tool-card-icon--active">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="23 7 16 12 23 17 23 7"/>
                        <rect x="1" y="5" width="15" height="14" rx="2"/>
                    </svg>
                </div>
                <div class="tool-card-body">
                    <span class="tool-badge tool-badge--ready">Ready</span>
                    <h2 class="tool-card-title">Video Frame Parser</h2>
                    <p class="tool-card-desc">Extract frames from any video at a custom frame rate and download them as a ZIP archive.</p>
                </div>
                <div class="tool-card-arrow">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                </div>
            </a>

            <a class="tool-card" asp-controller="MetadataCleaner" asp-action="Index">
                <div class="tool-card-icon tool-card-icon--active">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                        <path d="M14 2v6h6M9 13h6M9 17h4"/>
                    </svg>
                </div>
                <div class="tool-card-body">
                    <span class="tool-badge tool-badge--ready">Ready</span>
                    <h2 class="tool-card-title">Metadata Cleaner</h2>
                    <p class="tool-card-desc">Strip EXIF and embedded metadata from images, videos and PDFs before sharing.</p>
                </div>
                <div class="tool-card-arrow">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                </div>
            </a>

            <a class="tool-card" asp-controller="SoundParser" asp-action="Index">
                <div class="tool-card-icon tool-card-icon--active">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 18V5l12-2v13"/>
                        <circle cx="6" cy="18" r="3"/>
                        <circle cx="18" cy="16" r="3"/>
                    </svg>
                </div>
                <div class="tool-card-body">
                    <span class="tool-badge tool-badge--ready">Ready</span>
                    <h2 class="tool-card-title">Sound Parser</h2>
                    <p class="tool-card-desc">Extract the audio track from any video as MP3, AAC, WAV, FLAC or OGG.</p>
                </div>
                <div class="tool-card-arrow">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                </div>
            </a>

            <a class="tool-card" asp-controller="ImageOptimizer" asp-action="Index">
                <div class="tool-card-icon tool-card-icon--active">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="2"/>
                        <circle cx="8.5" cy="8.5" r="1.5"/>
                        <path d="M21 15l-5-5L5 21"/>
                    </svg>
                </div>
                <div class="tool-card-body">
                    <span class="tool-badge tool-badge--ready">Ready</span>
                    <h2 class="tool-card-title">Image Optimizer</h2>
                    <p class="tool-card-desc">Compress and convert images in bulk while preserving quality.</p>
                </div>
                <div class="tool-card-arrow">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                </div>
            </a>

            <div class="tool-card tool-card--disabled tool-card--placeholder">
                <div class="tool-card-icon">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="8" x2="12" y2="16"/>
                        <line x1="8" y1="12" x2="16" y2="12"/>
                    </svg>
                </div>
                <div class="tool-card-body">
                    <span class="tool-badge tool-badge--soon">Coming Soon</span>
                    <h2 class="tool-card-title">New Tool</h2>
                    <p class="tool-card-desc">Something new is on the way. Stay tuned.</p>
                </div>
            </div>

            <div class="tool-card tool-card--disabled tool-card--placeholder">
                <div class="tool-card-icon">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="8" x2="12" y2="16"/>
                        <line x1="8" y1="12" x2="16" y2="12"/>
                    </svg>
                </div>
                <div class="tool-card-body">
                    <span class="tool-badge tool-badge--soon">Coming Soon</span>
                    <h2 class="tool-card-title">New Tool</h2>
                    <p class="tool-card-desc">Something new is on the way. Stay tuned.</p>
                </div>
            </div>

        </div>
    </div>
</section>
