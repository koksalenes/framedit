<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Framedit</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
</head>
<body>
    <nav class="nav @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "nav--transparent" : "")">
        <div class="nav-inner">
            <a class="nav-logo" asp-controller="Home" asp-action="Index">Framedit</a>

            <ul class="nav-links">
                <li class="nav-item nav-item--dropdown">
                    <button class="nav-link nav-dropdown-toggle" id="toolsToggle" type="button" aria-expanded="false">
                        Tools
                        <svg class="dropdown-chevron" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9"/>
                        </svg>
                    </button>
                    <div class="nav-dropdown" id="toolsDropdown" hidden>
                        <a class="dropdown-item" asp-controller="VideoFrameParser" asp-action="Index">
                            <span class="dropdown-icon">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2"/>
                                </svg>
                            </span>
                            <span>
                                <span class="dropdown-item-title">Video Frame Parser</span>
                                <span class="dropdown-item-desc">Extract frames as ZIP</span>
                            </span>
                        </a>
                        <a class="dropdown-item" asp-controller="MetadataCleaner" asp-action="Index">
                            <span class="dropdown-icon">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/>
                                </svg>
                            </span>
                            <span>
                                <span class="dropdown-item-title">Metadata Cleaner</span>
                                <span class="dropdown-item-desc">Strip EXIF &amp; tags</span>
                            </span>
                        </a>
                        <a class="dropdown-item" asp-controller="SoundParser" asp-action="Index">
                            <span class="dropdown-icon">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>
                                </svg>
                            </span>
                            <span>
                                <span class="dropdown-item-title">Sound Parser</span>
                                <span class="dropdown-item-desc">Extract audio from video</span>
                            </span>
                        </a>
                        <a class="dropdown-item dropdown-item--soon" href="#">
                            <span class="dropdown-icon">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/>
                                </svg>
                            </span>
                            <span>
                                <span class="dropdown-item-title">Image Optimizer <span class="dropdown-soon-badge">Soon</span></span>
                                <span class="dropdown-item-desc">Compress &amp; resize</span>
                            </span>
                        </a>
                    </div>
                </li>
            </ul>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="footer-inner">
            <span>@DateTime.Now.Year Framedit.</span>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
